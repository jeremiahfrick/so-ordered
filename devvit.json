{
  "name": "so-ordered",
  "server": {
    "dir": "dist/server",
    "entry": "index.js"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "www.supremecourt.gov"
      ]
    },
    "redis": true,
    "reddit": true
  },
  "scheduler": {
    "tasks": {
      "poll": {
        "endpoint": "/internal/scheduler/poll",
        "cron": "*/2 * * * *"
      }
    }
  },
  "scripts": {
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --minify --outfile=dist/server/index.js"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "dev": {
    "subreddit": "so_ordered_dev"
  }
}